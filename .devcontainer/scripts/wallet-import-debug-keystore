#!/usr/bin/env bash
set -euo pipefail

workspace="$(git rev-parse --show-toplevel)"
target="$workspace/androidApp/keystore.p12"
properties="$workspace/local.properties"

[[ -d "$workspace/androidApp" ]] || {
    printf 'This command is only available in the compose-wallet-app checkout.\n' >&2
    exit 2
}

read -r -p 'Path to the PKCS#12 file already copied into the container: ' source
[[ -f "$source" ]] || { printf 'File not found: %s\n' "$source" >&2; exit 2; }
read -r -s -p 'PKCS#12 password: ' password
printf '\n'
read -r -p 'Expected alias [key0]: ' alias
alias="${alias:-key0}"

if ! keytool -list -storetype PKCS12 -keystore "$source" -storepass "$password" -alias "$alias" >/dev/null 2>&1; then
    unset password
    printf 'Password or alias validation failed; nothing was changed.\n' >&2
    exit 3
fi

if [[ -e "$target" ]]; then
    read -r -p 'A wallet keystore exists. Type REPLACE to overwrite it: ' confirmation
    [[ "$confirmation" == REPLACE ]] || { unset password; printf 'Import cancelled; nothing was changed.\n'; exit 4; }
fi

temp_properties="$(mktemp)"
trap 'rm -f "$temp_properties"' EXIT
found=false
if [[ -f "$properties" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*android\.cert\.password[[:space:]]*= ]]; then
            printf 'android.cert.password=%s\n' "$password" >>"$temp_properties"
            found=true
        else
            printf '%s\n' "$line" >>"$temp_properties"
        fi
    done <"$properties"
fi
[[ "$found" == true ]] || printf 'android.cert.password=%s\n' "$password" >>"$temp_properties"

install -m 0600 "$source" "$target"
install -m 0600 "$temp_properties" "$properties"
unset password
printf 'Imported %s as %s and updated local.properties. Remove the copied source file when no longer needed.\n' "$source" "$target"

